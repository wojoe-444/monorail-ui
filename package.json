{
  "name": "monorail-ui",
  "version": "0.1.0",
  "description": "MonoRail UI: a working catalog of components, page types and dashboards, and the template new apps start from",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "ui:add": "node scripts/add-ui.mjs",
    "app": "npm run build && electron .",
    "app:dist": "npm run build && electron-builder --win nsis",
    "backdrops": "node scripts/gen-backdrops.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.71.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.wojoe444.monorail-ui",
    "productName": "MonoRail UI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MonoRail UI"
    }
  }
}
